#!/usr/bin/env bash
# Render an Actually Useful Turtles screen in CraftOS-PC and save a screenshot.
#
#   ./tools/emulate                      groups page, 57x38 (advanced monitor)
#   ./tools/emulate groups               same, explicit
#   ./tools/emulate full                 the whole HostDisplay
#   ./tools/emulate groups --scenario stress
#   ./tools/emulate groups --size 51x19  computer terminal
#   ./tools/emulate groups --size 26x20  pocket computer
#   ./tools/emulate groups --open        open a window and LEAVE it open
#   ./tools/emulate --close              close any preview still open
#   ./tools/emulate --shell              drop into a live CraftOS-PC shell
#
# By default it renders offscreen and just writes the screenshot - no window.
# Use --open only when a preview is meant to be looked at; it then stays up
# until closed.
#
# The repo is mounted READ-ONLY inside the emulator and the emulated computer
# writes only to tools/emulator/out/. The live controller is never involved.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AUT="$REPO/ActuallyUsefulTurtles"
EMU="$REPO/tools/emulator"
OUT="$EMU/out"
APP="$HOME/.local/opt/craftos-pc/CraftOS-PC.x86_64.AppImage"

[ -x "$APP" ] || { echo "CraftOS-PC not found at $APP" >&2; exit 1; }

SCREEN="groups"
SCENARIO="default"
COLS=57
ROWS=38
KEEP=0
SHELL_MODE=0
TESTNAME=
PIDFILE=

while [ $# -gt 0 ]; do
  case "$1" in
    --scenario) SCENARIO="$2"; shift 2 ;;
    --size)     COLS="${2%x*}"; ROWS="${2#*x}"; shift 2 ;;
    --open)     KEEP=1; shift ;;
    --once)     KEEP=0; shift ;;
    --close)    pkill -f 'CraftOS-PC.*emulator/out/data' 2>/dev/null \
                  && echo "preview closed" || echo "no preview running"; exit 0 ;;
    --test)     TESTNAME="$2"; shift 2 ;;
    --shell)    SHELL_MODE=1; KEEP=0; shift ;;
    -h|--help)  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)         echo "unknown option: $1" >&2; exit 2 ;;
    *)          SCREEN="$1"; shift ;;
  esac
done

DATA="$OUT/data"
rm -rf "$DATA"
mkdir -p "$DATA/config" "$OUT"

# Terminal size = the screen we are emulating. CraftOS-PC reads these at start.
cat > "$DATA/config/global.json" <<JSON
{ "defaultWidth": $COLS, "defaultHeight": $ROWS, "checkUpdates": false,
  "romReadOnly": true, "showFPS": false, "useHardwareRenderer": false }
JSON

MOUNTS=(
  --mount-ro "/src/patch=$AUT/patches"
  --mount-ro "/src/tunnelnav=$AUT/tunnelnav"
  --mount-ro "/src/general=$AUT/controller/general"
  --mount-ro "/src/gui=$AUT/controller/gui"
  --mount-ro "/src/host=$AUT/controller/host"
  --mount-ro "/src/storage=$AUT/controller/storage"
  --mount-ro "/src/turtle=$AUT/controller/turtle"
  --mount-ro "/emu=$EMU"
)

# A real renderer is required: the dummy SDL driver creates no framebuffer, so
# term.screenshot() silently produces nothing. Hide the window off-screen rather
# than have it flash over whatever you are doing.
export SDL_VIDEODRIVER=x11
export DISPLAY="${DISPLAY:-:1}"
if [ "$KEEP" = "0" ]; then
  # screenshot-and-exit: keep the window off-screen so it does not flash up
  export SDL_VIDEO_WINDOW_POS="-4000,-4000"
fi

if [ "$SHELL_MODE" = "1" ]; then
  echo "CraftOS-PC shell. Repo mounted read-only at /src, harness at /emu."
  exec "$APP" --gui -d "$DATA" "${MOUNTS[@]}"
fi

if [ -n "$TESTNAME" ]; then
  # headless logic test: no rendering, just run the script and print its log
  SDL_VIDEODRIVER=dummy timeout 90 "$APP" --gui -d "$DATA" "${MOUNTS[@]}" \
    --script "$EMU/test_${TESTNAME}.lua" >/dev/null 2>&1
  if [ -f "$DATA/computer/0/test.log" ]; then
    cat "$DATA/computer/0/test.log"
    grep -q "^FAIL" "$DATA/computer/0/test.log" && exit 1
    exit 0
  fi
  echo "test produced no log" >&2; exit 1
fi

echo "rendering '$SCREEN' at ${COLS}x${ROWS} (scenario: $SCENARIO)"
DEST="$OUT/${SCREEN}-${SCENARIO}-${COLS}x${ROWS}.png"
LOG="$DATA/computer/0/harness.log"

# Deliberately does NOT close an already-open preview. Offscreen renders must
# never disturb a window you are looking at, and two previews side by side is
# often exactly what you want when comparing screens. Use --close to clear them.
set +e
if [ "$KEEP" = "1" ]; then
  "$APP" --gui -d "$DATA" "${MOUNTS[@]}" \
    --script "$EMU/harness.lua" --args "$SCREEN $SCENARIO keep" >/dev/null 2>&1 &
  APPPID=$!
  # wait for the render to land rather than guessing at a sleep
  for _ in $(seq 1 60); do
    [ -n "$(find "$DATA/screenshots" -name '*.png' 2>/dev/null | head -1)" ] && break
    kill -0 "$APPPID" 2>/dev/null || break
    sleep 0.5
  done
else
  timeout 90 "$APP" --gui -d "$DATA" "${MOUNTS[@]}" \
    --script "$EMU/harness.lua" --args "$SCREEN $SCENARIO" >/dev/null 2>&1
fi
rc=$?
set -e

[ -f "$LOG" ] && { echo "--- harness log ---"; cat "$LOG"; }

SHOT="$(find "$DATA/screenshots" -name '*.png' 2>/dev/null | sort | tail -1)"
if [ -n "$SHOT" ]; then
  cp "$SHOT" "$DEST"
  echo "--- screenshot: $DEST"
  [ "$KEEP" = "1" ] && echo "--- preview window open (previous ones left alone; ./tools/emulate --close clears all)"
else
  echo "--- no screenshot produced (exit $rc)" >&2
  exit 1
fi
